  <property name="styleSheet">
   <string notr="true">/* ===========================
   QDialog
=========================== */

QDialog{
    background-color: #F4F7FA;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

/* ===========================
   QLabel
=========================== */

QLabel{
    color: #0D3B66;
    font-size: 11pt;
    font-weight: bold;
    background: transparent;
}

/* ===========================
   QLineEdit
=========================== */

QLineEdit{
    background-color: white;
    border: 2px solid #D6D9DC;
    border-radius: 8px;
    padding: 6px;
    color: #1F2937;
    font-size: 10pt;
}

QLineEdit:focus{
    border: 2px solid #0D6EFD;
    background: #FFFFFF;
}

/* ===========================
   QPlainTextEdit
=========================== */

QPlainTextEdit{
    background-color: white;
    border: 2px solid #D6D9DC;
    border-radius: 10px;
    padding: 8px;
    color: #1F2937;
    font-size: 10pt;
    selection-background-color: #0D6EFD;
}

/* ===========================
   QPushButton
=========================== */

QPushButton{

    background-color: #0D3B66;
    color: white;

    border: none;
    border-radius: 10px;

    padding: 8px;

    font-size: 10pt;
    font-weight: bold;

}

QPushButton:hover{

    background-color: #145DA0;

}

QPushButton:pressed{

    background-color: #0A2A47;

}

QPushButton:disabled{

    background-color: #B0B7C3;
    color: #ECECEC;

}

/* ===========================
   ScrollBar
=========================== */

QScrollBar:vertical{

    background:#F4F7FA;
    width:12px;
    border:none;

}

QScrollBar::handle:vertical{

    background:#0D3B66;
    border-radius:6px;

}

QScrollBar::handle:vertical:hover{

    background:#145DA0;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{

    height:0px;

}

QScrollBar:horizontal{

    background:#F4F7FA;
    height:12px;
    border:none;

}

QScrollBar::handle:horizontal{

    background:#0D3B66;
    border-radius:6px;

}

QScrollBar::handle:horizontal:hover{

    background:#145DA0;

}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{

    width:0px;

}</string>
