  <property name="styleSheet">
   <string notr="true">/* Ventana principal */
QDialog {
    background-color: #F4F7FB;
    border-radius: 12px;
}

/* Etiquetas */
QLabel {
    color: #1F2937;
    font-size: 13px;
    font-weight: bold;
}


/* Campos de texto */
QLineEdit {
    background-color: white;
    border: 2px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px;
    font-size: 13px;
    color: #111827;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}


/* Área de cola */
QPlainTextEdit {
    background-color: white;
    border: 2px solid #CBD5E1;
    border-radius: 10px;
    padding: 10px;
    font-size: 13px;
    color: #111827;
}


/* Botones */
QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 15px;
    font-size: 13px;
    font-weight: bold;
}


QPushButton:hover {
    background-color: #1D4ED8;
}


QPushButton:pressed {
    background-color: #1E40AF;
}


/* Botón imprimir diferente */
#btn_imprimir {
    background-color: #059669;
}

#btn_imprimir:hover {
    background-color: #047857;
}


/* Botón consultar frente */
#btn_frente {
    background-color: #F59E0B;
}

#btn_frente:hover {
    background-color: #D97706;
}


/* Labels de información */
#lbl_total,
#lbl_frente,
#lbl_mensaje {
    background-color: white;
    border-radius: 8px;
    padding: 6px;
    border: 1px solid #E5E7EB;
    color: #374151;
}


/* Título de secciones */
#label,
#label_2,
#label_3,
#label_4 {
    color: #1E3A8A;
    font-size: 14px;
}</string>
