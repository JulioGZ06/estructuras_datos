   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_capture">
     <item>
      <widget class="QGroupBox" name="groupVertices">
       <property name="title">
        <string>Vértices</string>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_vertices">
        <item>
         <widget class="QLineEdit" name="txtVertex">
          <property name="placeholderText">
           <string>Nombre del vértice</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnAddVertex">
          <property name="text">
           <string>Agregar vértice</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmbVertex"/>
        </item>
        <item>
         <widget class="QPushButton" name="btnDeleteVertex">
          <property name="text">
           <string>Eliminar vértice</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupEdges">
       <property name="title">
        <string>Arcos</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_edges">
        <item row="0" column="0">
         <widget class="QLabel" name="lblOrigin">
          <property name="text">
           <string>Vértice 1</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="cmbOrigin"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lblDestination">
          <property name="text">
           <string>Vértice 2</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="cmbDestination"/>
        </item>
        <item row="2" column="0" colspan="2">
         <widget class="QPushButton" name="btnAddEdge">
          <property name="text">
           <string>Agregar arco</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0" colspan="2">
         <widget class="QPushButton" name="btnDeleteEdge">
          <property name="text">
           <string>Eliminar arco</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="tabWidgetGraph">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tabVisual">
