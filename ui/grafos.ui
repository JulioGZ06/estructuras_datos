      <layout class="QVBoxLayout" name="verticalLayout_tab4">
       <item>
        <widget class="QTableWidget" name="tblEdges">
         <property name="editTriggers">
          <set>QAbstractItemView::NoEditTriggers</set>
         </property>
         <column>
          <property name="text">
           <string>Vértice 1</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Vértice 2</string>
          </property>
         </column>
        </widget>
